<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- HD RGB frames need more room than Fast DDS's default 512 KiB segment.
       Keep UDP discovery/network peers, and use a 128 MiB local image/map segment. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>mako_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>mako_hd_shm</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <maxMessageSize>8388608</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="mako_hd" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>mako_udp</transport_id>
        <transport_id>mako_hd_shm</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
