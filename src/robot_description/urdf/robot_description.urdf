  <xacro:zed2i_sim />
  <joint name="zed2i_mount_joint" type="fixed">
    <parent link="rov_base_link" />
    <child link="zed2i_camera_link" />
    <origin xyz="0.255 0 0.015" rpy="0 0 0" />
  </joint>
  <xacro:include filename="bottom_camera.urdf.xacro" />
  <xacro:include filename="third_person_camera.urdf.xacro" />
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="imu_ros_link">
    <sensor name="imu_ros_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <topic>/mako/imu</topic>
      <gz_frame_id>imu_ros_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <namespace>mako</namespace>
      <link_name>hydrodynamics_link</link_name>
      <xDotU>1.5</xDotU>
      <yDotV>2.5</yDotV>
      <zDotW>2.5</zDotW>
      <kDotP>0.02</kDotP>
      <mDotQ>0.05</mDotQ>
      <nDotR>0.05</nDotR>
      <xUabsU>-60.0</xUabsU>
      <xU>-10.0</xU>
      <yVabsV>-100.0</yVabsV>
      <yV>-10.0</yV>
      <zWabsW>-100.0</zWabsW>
      <zW>-10.0</zW>
      <kPabsP>-4.0</kPabsP>
      <kP>-3.5</kP>
      <mQabsQ>-4.0</mQabsQ>
      <mQ>-3.5</mQ>
      <nRabsR>-4.0</nRabsR>
      <nR>-1.0</nR>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>robot_description</namespace>
      <joint_name>t1_joint</joint_name>
      <fluid_density>998</fluid_density>
      <thrust_coefficient>0.019</thrust_coefficient>
      <propeller_diameter>0.076</propeller_diameter>
      <velocity_control>true</velocity_control>
      <deadband>0.05</deadband>
      <max_thrust_cmd>51.5</max_thrust_cmd>
      <min_thrust_cmd>-51.5</min_thrust_cmd>
    </plugin>
  </gazebo>
