<package format="3">
  <name>robot_description</name>
  <version>1.0.0</version>
  <description>
    <p>Mako ROV description and simulation world.</p>
    <p>URDF/xacro model, meshes, Gazebo Harmonic worlds and task assets, the
  pool-waves Gazebo plugin, ROS-Gazebo bridge configuration and the launch file
  that starts Gazebo with the robot. Vision and control live in mako_vision and
  mako_control; mako_bringup composes them.</p>
  </description>
  <maintainer email="marinexperts@todo.todo">MarineXperts software team</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-transport13</depend>
  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>rviz2</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>xacro</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
