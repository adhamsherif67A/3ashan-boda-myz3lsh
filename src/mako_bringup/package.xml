<?xml version="1.0"?>
<package format="3">
  <name>mako_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch files that compose the independent Mako packages (robot_description,
    mako_vision, mako_control) into the complete simulation.
  </description>
  <maintainer email="marinexperts@todo.todo">MarineXperts software team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>mako_control</exec_depend>
  <exec_depend>mako_vision</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
