<?xml version="1.0"?>
<package format="3">
  <name>mako_vision</name>
  <version>1.0.0</version>
  <description>
    Mako ROV vision: ZED RGB-D visual odometry and RTAB-Map SLAM launch/configuration,
    the bottom-camera transect detector, and the hardware ZED pose relay to MAVROS.
  </description>
  <maintainer email="marinexperts@todo.todo">MarineXperts software team</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>robot_mapping</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
